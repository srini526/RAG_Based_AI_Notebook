# ---- Required ----
GROQ_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=          # needs "Workers AI" permission

# Comma-separated list of frontend origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173

# ---- Database: notebooks are saved here ----
# Default is a local SQLite file (fine for local use). On hosts with a temporary disk (Hugging Face
# free Spaces) use a free hosted Postgres (Neon or Supabase) and paste its connection string:
# DATABASE_URL=postgresql://user:password@host/dbname
# MAX_NOTEBOOKS_PER_OWNER=10
# NOTEBOOK_RETENTION_DAYS=60   # delete notebooks untouched this long (0 = keep forever)
# SOURCE_GUIDES=true           # write a short guide for each new source (1 extra LLM call)

# ---- Web search fallback (optional but recommended; free key at tavily.com) ----
# TAVILY_API_KEY=

# ---- Agent behaviour (defaults shown) ----
# MAX_REWRITES=2          # query rewrites before falling back to the web
# GRADE_DOCS=true         # LLM relevance grading of retrieved passages
# SELF_CHECK=true         # fact-check answers against their sources (1 extra LLM call)
# WEB_FALLBACK=true
# MAX_HISTORY_MESSAGES=10 # conversation memory fed to the model
# LLM_MODEL=openai/gpt-oss-20b
# WHISPER_MODEL=whisper-large-v3
# WHISPER_LANGUAGE=       # empty = auto-detect, e.g. "hi" or "en"
# TOP_K=6
# GEN_CONTEXT_CHARS=12000   # how much material one Summary/Quiz/Code call reads (keep small on free tiers)

# ---- Limits ----
# MAX_UPLOAD_MB=100
# MAX_MEDIA_MINUTES=120
# MAX_DOCS_PER_SESSION=10
# MAX_LOADED_NOTEBOOKS=30  # notebooks kept in memory (~12 MB of vectors each when full); the rest load from the database
# IDLE_UNLOAD_MINUTES=60
# RATE_LIMIT_CHAT=20 per minute
# RATE_LIMIT_INGEST=20 per hour

# ---- Global daily caps (protect your free-tier quotas on a public demo; 0 = unlimited) ----
# DAILY_CHAT_LIMIT=2000
# DAILY_GENERATE_LIMIT=300
# DAILY_INGEST_LIMIT=300

# ---- Reverse proxy ----
# TRUST_PROXY_HOPS=1      # proxies in front of the app (0 = none). Wrong values break per-IP rate limits.

# ---- LangSmith tracing (optional, set to inspect every graph run) ----
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=rag-study-assistant

# ---- YouTube ----
# YOUTUBE_PROXY_URL=
# YTDLP_COOKIES_FILE=
# LOG_LEVEL=INFO
